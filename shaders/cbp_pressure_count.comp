#version 450
// Kyoto Phase 11 Vulkan compute: exact all-pairs AABB COUNT-ONLY reference.
// One work item owns every j > i. Outputs no potentially TB-scale pair list.
// Two 32-bit commutative fingerprints are compared against independent CPU
// 3D canonical-cell enumeration, never used as a proof of full pair equality.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

struct AABB { vec4 lo; vec4 hi; };
struct Result { uint count; uint sum32; uint xor32; uint tests; };
layout(std430, binding = 0) readonly buffer Bounds { AABB boxes[]; };
layout(std430, binding = 1) writeonly buffer Counts { Result result[]; };
layout(push_constant) uniform Run { uint count; } params;

uint fingerprint(uint a,uint b) {
    uint x = a * 0x9e3779b9u + b * 0x85ebca6bu + 0x165667b1u;
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    return x ^ (x >> 16);
}
bool overlaps(AABB a, AABB b) {
    return all(lessThanEqual(a.lo.xyz,b.hi.xyz))
        && all(lessThanEqual(b.lo.xyz,a.hi.xyz));
}
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.count) return;
    AABB a = boxes[i];
    uint candidates = 0u;
    uint sum = 0u;
    uint x = 0u;
    uint tests = 0u;
    for (uint j = i + 1u; j < params.count; ++j) {
        ++tests;
        if (overlaps(a, boxes[j])) {
            uint h = fingerprint(i,j);
            ++candidates;
            sum += h;
            x ^= h;
        }
    }
    result[i] = Result(candidates,sum,x,tests);
}
